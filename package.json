{
  "name": "barbershop_prod",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "dotenv -e .env.development -- next dev -p 3000",
    "dev:test": "dotenv -e .env.test -- next dev -p 3000",
    "test": "dotenv -e .env.test -- jest --runInBand --verbose",
    "test:watch": "dotenv -e .env.test -- jest --watchAll --runInBand --verbose",
    "test:dev": "concurrently -k -s first --hide next -n next,tests \"npm run dev:test\" \"npm run services:wait && npm run test\"",
    "test:ci": "dotenv -e .env.test -- prisma migrate reset --force && dotenv -e .env.test -- jest --runInBand --verbose",
    "services:wait": "dotenv -e .env.test -- cross-env NODE_ENV=test node src/tests/orchestrator/wait-for-services.mjs",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start -p 3000",
    "prepare": "husky",
    "db:generate": "dotenv -e .env.development -- prisma generate",
    "db:migrate": "dotenv -e .env.development -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "dotenv -e .env.development -- prisma db push",
    "db:studio": "dotenv -e .env.development -- prisma studio",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier . --write --ignore-path=.prettierignore",
    "lint:eslint:check": "eslint . --max-warnings=0",
    "lint:eslint:fix": "eslint . --fix",
    "db:seed:admin": "node src/scripts/seed-admin.mjs",
    "db:seed:admin:dev": "dotenv -e .env.development -- npm run db:seed:admin",
    "db:seed:admin:test": "dotenv -e .env.test -- npm run db:seed:admin",
    "db:seed:admin:prod": "dotenv -e .env.production -- npm run db:seed:admin",
    "db:reset:development": "dotenv -e .env.development -- prisma migrate reset --force",
    "db:reset:test": "dotenv -e .env.test -- prisma migrate reset --force"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "9.7.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.2.4",
    "bcryptjs": "3.0.3",
    "cookie": "1.1.1",
    "dotenv": "17.4.2",
    "next": "16.2.4",
    "next-connect": "1.0.0",
    "nextjs-toast-notify": "1.61.0",
    "pg": "8.20.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/css": "1.2.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@eslint/json": "1.2.0",
    "@eslint/markdown": "8.0.1",
    "@next/eslint-plugin-next": "16.2.4",
    "async-retry": "1.3.3",
    "autoprefixer": "10.5.0",
    "concurrently": "9.2.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.15.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "postcss": "8.5.13",
    "prettier": "3.8.3",
    "prisma": "7.8.0",
    "set-cookie-parser": "3.1.0",
    "tailwindcss": "4.2.4",
    "wait-on": "9.0.5"
  }
}
